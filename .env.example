# ==============================================================================
# Environment Variables Template for AI Prompt Governance Engine
# ==============================================================================
# Copy this file to .env and fill in your details:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
ENV=prod                          # environment: dev, staging, prod
LOG_LEVEL=INFO                    # logging detail level: DEBUG, INFO, WARNING, ERROR
PORT=8000                         # port for local execution (defaults to 10000 on Render)
WORKERS=4                         # number of uvicorn server workers for concurrency

# ------------------------------------------------------------------------------
# Google Gemini API Settings
# ------------------------------------------------------------------------------
# Required for unified LLM provider calls (Gemini 2.5 Flash / Pro)
GEMINI_API_KEY=your_gemini_api_key_here


# ------------------------------------------------------------------------------
# Neon PostgreSQL Database Settings
# ------------------------------------------------------------------------------
# Set DATABASE_URL directly for cloud database (e.g. Neon, Render PostgreSQL).
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:password@ep-cool-snowflake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Alternatively (for local development fallback):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portkey_prompt_parser
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable

# ------------------------------------------------------------------------------
# Upstash Redis Caching / Rate Limiting Settings
# ------------------------------------------------------------------------------
# Set REDIS_URL directly for cloud Redis instances (e.g. Upstash).
# Format: rediss://default:[password]@[host]:[port]
REDIS_URL=rediss://default:redispassword@cool-marmot-12345.upstash.io:6379
# Alternatively (for local development fallback):
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------------------
# Qdrant Cloud Vector Database Settings
# ------------------------------------------------------------------------------
# Set QDRANT_URL directly for Qdrant Cloud cluster.
# Format: https://your-cluster-id.qdrant.tech:6333
QDRANT_URL=https://your-qdrant-cluster.us-east-1.aws.qdrant.tech:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# Alternatively (for local development fallback):
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ------------------------------------------------------------------------------
# AWS Settings (Optional / Disabled for Render native python deployment)
# ------------------------------------------------------------------------------
AWS_SECRETS_ENABLED=false
AWS_REGION=us-east-2
S3_BUCKET_NAME=your-s3-bucket-name
